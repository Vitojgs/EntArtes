        {
          "name": "5.2 Marcar aula como realizada",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Fetch the confirmed aula's pedido ID dynamically",
                  "pm.sendRequest({",
                  "  url: pm.environment.get('baseUrl') + '/api/professor/aulas',",
                  "  method: 'GET',",
                  "  header: { 'Authorization': 'Bearer ' + pm.environment.get('authToken') }",
                  "}, function (err, res) {",
                  "  if (err) { return console.log('Erro:', err); }",
                  "  var dados = res.json();",
                  "  if (dados.success && dados.data && dados.data.length > 0) {",
                  "    var aprovada = dados.data.find(function(a) { return a.estado_nome && a.estado_nome.toUpperCase() === 'CONFIRMADA'; });",
                  "    if (aprovada && aprovada.idpedidoaula) {",
                  "      pm.environment.set('pedidoId', aprovada.idpedidoaula);",
                  "      console.log('Pedido a marcar realizada:', aprovada.idpedidoaula);",
                  "    }",
                  "  }",
                  "});"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Marcar realizada - Status 200\", function() { pm.response.to.have.status(200); });",
                  "var json = pm.response.json();",
                  "console.log('Aula marcada como realizada:', json.success);"
                ]
              }
            }
