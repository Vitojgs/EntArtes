      "name": "FASE 1: Professor cria disponibilidade",
      "item": [
        {
          "name": "1.1 Login Professor",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Login professor - Status 200\", function() { pm.response.to.have.status(200); });",
                  "var json = pm.response.json();",
                  "pm.environment.set('authToken', json.token);",
                  "pm.environment.set('professorId', json.user.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\"email\": \"joao.santos@entartes.pt\", \"password\": \"password123\"}"},
            "url": {"raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"]}
          }
        },
        {
          "name": "1.2 Criar disponibilidade futura",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Calculate a unique future date",
                  "var now = new Date();",
                  "var future = new Date(now);",
                  "future.setDate(future.getDate() + 10);",
                  "var y = future.getFullYear();",
                  "var m = String(future.getMonth() + 1).padStart(2,'0');",
                  "var d = String(future.getDate()).padStart(2,'0');",
                  "pm.environment.set('slotDate', y+'-'+m+'-'+d);",
                  "console.log('Data do slot:', y+'-'+m+'-'+d);",
                  "",
                  "// Fetch professor's modalidades for dynamic modalidadeprofessor ID",
                  "pm.sendRequest({",
                  "  url: pm.environment.get('baseUrl') + '/api/professor/modalidades',",
                  "  method: 'GET',",
                  "  header: { 'Authorization': 'Bearer ' + pm.environment.get('authToken') }",
                  "}, function (err, res) {",
                  "  if (err) { return console.log('Erro ao buscar modalidades:', err); }",
                  "  var json = res.json();",
                  "  if (json.success && json.data && json.data.length > 0) {",
                  "    pm.environment.set('modalidadeProfId', json.data[0].idmodalidadeprofessor);",
                  "    console.log('ModalidadeProf ID:', json.data[0].idmodalidadeprofessor);",
                  "  }",
                  "});"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Criar disponibilidade - Status 201 ou 409\", function() { pm.expect(pm.response.code).to.be.oneOf([201, 409]); });",
                  "var json = pm.response.json();",
                  "if (json.data && json.data[0]) {",
                  "  pm.environment.set('slotId', json.data[0].id);",
                  "  pm.environment.set('slotData', json.data[0].data);",
                  "  console.log('Slot criado:', json.data[0].id, 'para data:', json.data[0].data);",
                  "} else if (json.success === false && pm.response.code === 409) {",
                  "  pm.sendRequest({",
                  "    url: pm.environment.get('baseUrl') + '/api/professor/disponibilidades',",
                  "    method: 'GET',",
                  "    header: { 'Authorization': 'Bearer ' + pm.environment.get('authToken') }",
                  "  }, function (err, res) {",
                  "    if (err) { return console.log('Erro:', err); }",
                  "    var data = res.json();",
                  "    if (data.success && data.data && data.data.length > 0) {",
                  "      var sd = pm.environment.get('slotDate');",
                  "      var found = data.data.find(function(s) { return s.data === sd; });",
                  "      if (found) {",
                  "        pm.environment.set('slotId', found.id);",
                  "        console.log('Slot existente:', found.id, found.data);",
                  "      }",
                  "    }",
                  "  });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{authToken}}"}
            ],
            "body": {"mode": "raw", "raw": "{\"data\": \"{{slotDate}}\", \"horainicio\": \"14:00\", \"horafim\": \"15:00\", \"salaid\": 1, \"modalidadesprofessoridmodalidadeprofessor\": {{modalidadeProfId}}}"},
            "url": {"raw": "{{baseUrl}}/api/professor/disponibilidades", "host": ["{{baseUrl}}"], "path": ["api", "professor", "disponibilidades"]}
          }
        },
        {
          "name": "1.3 Logout Professor",
