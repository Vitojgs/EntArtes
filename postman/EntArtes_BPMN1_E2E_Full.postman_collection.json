      "name": "FASE 1: Professor cria disponibilidade",
      "item": [
        {
          "name": "1.1 Login Professor",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Login professor - Status 200\", function() { pm.response.to.have.status(200); });",
                  "var json = pm.response.json();",
                  "pm.environment.set('authToken', json.token);",
                  "pm.environment.set('professorId', json.user.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\"email\": \"joao.santos@entartes.pt\", \"password\": \"password123\"}"},
            "url": {"raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"]}
          }
        },
        {
          "name": "1.2 Criar disponibilidade futura",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Criar disponibilidade - Status 201 ou 409\", function() { pm.expect(pm.response.code).to.be.oneOf([201, 409]); });",
                  "var json = pm.response.json();",
                  "if (json.data && json.data[0]) {",
                  "  pm.environment.set('slotId', json.data[0].id);",
                  "  pm.environment.set('slotData', json.data[0].data);",
                  "  console.log('Slot criado:', json.data[0].id, 'para data:', json.data[0].data);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{authToken}}"}
            ],
            "body": {"mode": "raw", "raw": "{\"data\": \"2026-05-20\", \"horainicio\": \"14:00\", \"horafim\": \"15:00\", \"salaid\": 1, \"modalidadesprofessoridmodalidadeprofessor\": 35}"},
            "url": {"raw": "{{baseUrl}}/api/professor/disponibilidades", "host": ["{{baseUrl}}"], "path": ["api", "professor", "disponibilidades"]}
          }
        },
        {
          "name": "1.3 Logout Professor",
          "event": [
            {
              "listen": "test",
              "script": {"type": "text/javascript", "exec": ["pm.test(\"Logout - Status 200\", function() { pm.response.to.have.status(200); });"]}
