    {
      "name": "BPMN1 - Marcação de Aula",
      "item": [
        {
          "name": "1. Ver Disponibilidades",
          "event": [
            {
              "listen": "test",
              "script": {
                "id": "test-get-disponibilidades",
                "type": "text/javascript",
                "exec": [
                  "// TESTE DE INTEGRAÇÃO - Listar disponibilidades",
                  "// Objetivo: Obter lista de disponibilidade de professores",
                  "// Tipo: Teste de Integração - Leitura",
                  "// Fluxo BPMN: Passo 1 do BPMN1 (pré-requisito)",
                  "",
                  "pm.test('Disponibilidades - Status 200', function() {",
                  "    pm.expect(pm.response.code).to.eql(200);",
                  "});",
                  "",
                  "pm.test('Disponibilidades - Array retornado', function() {",
                  "    const responseJson = pm.response.json();",
                  "    pm.expect(responseJson).to.be.an('array');",
                  "});",
                  "",
                  "pm.test('Disponibilidades - Tem campos necessários', function() {",
                  "    const responseJson = pm.response.json();",
                  "    if (responseJson.length > 0) {",
                  "        const disp = responseJson[0];",
                  "        pm.expect(disp).to.have.property('iddisponibilidade_mensal');",
                  "        pm.expect(disp).to.have.property('data');",
                  "        pm.expect(disp).to.have.property('horaInicio');",
                  "        ",
                  "        // Guardar primeiro ID",
                  "        pm.environment.set('disponibilidade_id', disp.iddisponibilidade_mensal);",
                  "    }",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/encarregado/disponibilidades",
              "host": ["{{base_url}}"],
              "path": ["api", "encarregado", "disponibilidades"]
            }
          }
        },
        {
          "name": "2. Criar Pedido (data futura)",
          "event": [
            {
              "listen": "test",
              "script": {
                "id": "test-criar-pedido",
                "type": "text/javascript",
                "exec": [
                  "// TESTE DE INTEGRAÇÃO - Criar pedido de aula",
                  "// Objetivo: Criar pedido com data futura (sucesso)",
                  "// Tipo: Teste de Integração - Criação (CRUD)",
                  "// Fluxo BPMN1: Passo 1 - EE submete pedido",
                  "",
                  "pm.test('Criar pedido - Status 201', function() {",
                  "    pm.expect(pm.response.code).to.eql(201);",
                  "});",
                  "",
                  "pm.test('Criar pedido - Retorna dados', function() {",
                  "    const responseJson = pm.response.json();",
                  "    pm.expect(responseJson).to.have.property('idpedidoaula');",
                  "    pm.expect(responseJson).to.have.property('data');",
                  "",
                  "    // Guardar ID para próximo teste",
                  "    pm.environment.set('pedido_id', responseJson[0]?.idpedidoaula || responseJson.idpedidoaula);",
                  "});",
                  "",
                  "pm.test('Criar pedido - Estado inicial PENDENTE', function() {",
                  "    const responseJson = pm.response.json();",
                  "    const estado = responseJson.estado || responseJson[0]?.estado;",
                  "    pm.expect(estado).to.contain('PENDENTE');",
                  "});"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "id": "pre-criar-pedido",
                "type": "text/javascript",
                "exec": [
                  "// PRÉ-REQUEST - Obter próximo token antes de criar",
                  "const token = pm.environment.get('jwt_token');",
                  "console.log('Token atual:', token ? 'definido' : 'não definido');"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"data\": \"{{future_date}}\",\n    \"horainicio\": \"14:00\",\n    \"duracaoaula\": \"60\",\n    \"disponibilidade_mensal_id\": \"{{disponibilidade_id}}\",\n    \"professor_utilizador_id\": \"{{professor_id}}\",\n    \"salaidsala\": \"{{sala_id}}\",\n    \"alunoutilizadoriduser\": \"{{aluno_id}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/encarregado/aulas",
              "host": ["{{base_url}}"],
              "path": ["api", "encarregado", "aulas"]
            }
          }
        },
        {
          "name": "3a. Ver meus pedidos (Encarr.)",
          "event": [
            {
              "listen": "test",
              "script": {
                "id": "test-get-my-pedidos",
                "type": "text/javascript",
                "exec": [
                  "// TESTE DE INTEGRAÇÃO - Listar pedidos do ENCARREGADO",
                  "// Objetivo: Ver pedidos criados pelo encarregado",
                  "// Tipo: Teste de Integração - Leitura",
                  "// Fluxo BPMN1: Verificar estado após criação",
                  "",
                  "pm.test('Meus pedidos - Status 200', function() {",
                  "    pm.expect(pm.response.code).to.eql(200);",
                  "});",
                  "",
                  "pm.test('Meus pedidos - Array retornado', function() {",
                  "    const responseJson = pm.response.json();",
                  "    pm.expect(responseJson).to.be.an('array');",
                  "});",
                  "",
                  "pm.test('Meus pedidos - Contém pedido criado', function() {",
                  "    const responseJson = pm.response.json();",
                  "    const pedidoId = pm.environment.get('pedido_id');",
                  "    const found = responseJson.find(p => p.id === pedidoId || p.idpedidoaula == pedidoId);",
                  "    if (pedidoId) {",
                  "        pm.expect(found).to.not.be.undefined;",
                  "    }",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/encarregado/aulas",
              "host": ["{{base_url}}"],
              "path": ["api", "encarregado", "aulas"]
            }
          }
        },
        {
          "name": "3b. Ver pedidos pendentes (Dir.)",
          "event": [
            {
              "listen": "test",
              "script": {
                "id": "test-get-pending",
                "type": "text/javascript",
                "exec": [
                  "// TESTE DE INTEGRAÇÃO - Ver pedidos pendentes",
                  "// Objetivo: DIREÇÃO vê pedidos pendentes",
                  "// Tipo: Teste de Integração - Leitura",
                  "// Fluxo BPMN1: Passo 2 - Direção visualiza",
                  "",
                  "pm.test('Pedidos pendentes - Status 200', function() {",
                  "    pm.expect(pm.response.code).to.eql(200);",
                  "});",
                  "",
                  "pm.test('Pedidos pendentes - Array retornado', function() {",
                  "    const responseJson = pm.response.json();",
                  "    pm.expect(responseJson).to.be.an('array');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/direcao/aulas/pending",
              "host": ["{{base_url}}"],
              "path": ["api", "direcao", "aulas", "pending"]
            }
          }
        },
        {
          "name": "4. Aprovar pedido (Direção)",
          "event": [
            {
              "listen": "test",
              "script": {
                "id": "test-aprovar-pedido",
                "type": "text/javascript",
                "exec": [
                  "// TESTE E2E - Aprovar pedido",
                  "// Objetivo: DIREÇÃO aprova pedido pendente",
                  "// Tipo: Teste End-to-End - Atualização",
                  "// Fluxo BPMN1: Passo 2 - Direção aprova",
                  "",
                  "pm.test('Aprovar pedido - Status 200', function() {",
                  "    pm.expect(pm.response.code).to.eql(200);",
                  "});",
                  "",
                  "pm.test('Aprovar pedido - Estado alterado', function() {",
                  "    const responseJson = pm.response.json();",
                  "    const estado = responseJson.estado || responseJson.estado_nome;",
                  "    pm.expect(estado).to.contain('CONFIRMADO');",
                  "});",
                  "",
                  "pm.test('Aprovar pedido - Notificação enviada', function() {",
                  "    const responseJson = pm.response.json();",
                  "    pm.expect(responseJson).to.have.property('message');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"acao\": \"aprovar\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/direcao/aulas/{{pedido_id}}/approve",
              "host": ["{{base_url}}"],
              "path": ["api", "direcao", "aulas", "{{pedido_id}}", "approve"]
            }
          }
        },
