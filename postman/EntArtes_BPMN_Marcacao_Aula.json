{
  "info": {
    "_postman_id": "entartes-bpmn-marcacao-aula",
    "name": "Ent'Artes - BPMN Marcação de Aula",
    "description": "Coleção completa de testes para o BPMN de Marcação de Aula do sistema Ent'Artes.\n\n## Fluxo BPMN 1: Marcação de Aula\n1. ENCARREGADO submete pedido de aula\n2. DIREÇÃO aprova ou rejeita\n3. Aula confirmado ou rejeitada\n\n## Fluxo BPMN 2: Remarcação\n1. DIREÇÃO propõe nova data\n2. PROFESSOR aceita ou rejeita\n3. ENCARREGADO aceita ou rejeita\n4. Aula remarcada ou cancelar\n\n## Fluxos BPMN 3-4: Figurinos (Marketplace)\n1. ENCARREGADO cria anúncio/aluguer\n2. DIREÇÃO aprova\n\n**Testes Incluídos:**\n- Unitários: Validação de endpoints\n- Integração: Fluxos CRUD completos\n- E2E: Sequências completas com autenticação\n\n**Autores:** Equipa Ent'Artes\n**Data:** 2026-04-30",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "id": "setup-vars",
        "type": "text/javascript",
        "exec": [
          "// Script de configuração - Executado antes de cada pedido",
          "// Atualiza variáveis dinâmicas",
          "",
          "const today = new Date();",
          "const tomorrow = new Date(today);",
          "tomorrow.setDate(tomorrow.getDate() + 1);",
          "const nextWeek = new Date(today);",
          "nextWeek.setDate(nextWeek.getDate() + 7);",
          "const yesterday = new Date(today);",
          "yesterday.setDate(yesterday.getDate() - 1);",
          "",
          "pm.environment.set('today_date', today.toISOString().split('T')[0]);",
          "pm.environment.set('future_date', tomorrow.toISOString().split('T')[0]);",
          "pm.environment.set('future_date_week', nextWeek.toISOString().split('T')[0]);",
          "pm.environment.set('past_date', yesterday.toISOString().split('T')[0]);",
          "",
          "console.log('Data hoje:', pm.environment.get('today_date'));",
          "console.log('Data futura:', pm.environment.get('future_date'));",
          "console.log('Data passada:', pm.environment.get('past_date'));"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "id": "response-logger",
        "type": "text/javascript",
        "exec": [
          "// Script de resposta - Executado após cada pedido",
          "// Log de responses para debug",
          "",
          "console.log('Status:', pm.response.status);",
          "console.log('Status Code:', pm.response.code);",
          "if (pm.response.status === 'OK' || pm.response.status === 'Created') {",
          "    console.log('✓ Request bem succedida');",
          "} else if (pm.response.status === 'Bad Request') {",
          "    console.log('✗ Erro de validação');",
          "} else if (pm.response.status === 'Unauthorized') {",
          "    console.log('✗ Não autorizado');",
          "} else if (pm.response.status === 'Not Found') {",
          "    console.log('✗ Recurso não encontrado');",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "AUTH - Autenticação",
      "item": [
        {
          "name": "Login como Encarregado",
          "event": [
            {
              "listen": "test",
              "script": {
                "id": "test-login-encarregado",
                "type": "text/javascript",
                "exec": [
                  "// TESTE UNITÁRIO - Autenticação",
                  "// Objetivo: Validar endpoint de login para ENCARREGADO",
                  "// Tipo: Teste Unitário",
                  "// Fluxo BPMN: Autenticação prévia necessária",
                  "",
                  "pm.test('Login ENCARREGADO - Status 200', function() {",
                  "    pm.expect(pm.response.code).to.eql(200);",
                  "});",
                  "",
                  "pm.test('Login ENCARREGADO - Token retornado', function() {",
                  "    const responseJson = pm.response.json();",
                  "    pm.expect(responseJson).to.have.property('token');",
                  "    pm.expect(responseJson.token).to.not.be.empty;",
                  "});",
                  "",
                  "pm.test('Login ENCARREGADO - Dados do utilizador', function() {",
                  "    const responseJson = pm.response.json();",
                  "    pm.expect(responseJson).to.have.property('user');",
                  "    pm.expect(responseJson.user.role).to.eql('ENCARREGADO');",
                  "",
                  "    // Guardar para próxima requisição",
                  "    pm.environment.set('jwt_token', responseJson.token);",
                  "    pm.environment.set('user_id', responseJson.user.id);",
                  "    pm.environment.set('user_role', responseJson.user.role);",
                  "    pm.environment.set('encarregado_id', responseJson.user.id);",
                  "});"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "id": "pre-login-encarregado",
                "type": "text/javascript",
                "exec": [
                  "// PRÉ-REQUEST - Configurar body do login"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"{{encarregado_email}}\",\n    \"password\": \"{{encarregado_password}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Autentica como ENCARREGADO de educação para obter token JWT"
          }
        },
