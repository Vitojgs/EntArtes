          "name": "6. Ver pedidos pendentes (DIRECAO)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.expect(pm.response.status).to.eql(200));",
                  "",
                  "const pending = pm.response.json().data || [];",
                  "if (pending.length > 0) {",
                  "    pm.environment.set('pendingPedidoId', pending[0].id);",
                  "    console.log('Pending pedido:', pending[0].id, pending[0].status);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/direcao/aulas/pending",
              "path": ["api", "direcao", "aulas", "pending"]
            }
          }
        },
        {
          "name": "7. Aprovar pedido (DIRECAO)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.expect(pm.response.status).to.eql(200));",
                  "pm.test('Approved', () => pm.expect(pm.response.json().success).to.be.true);",
                  "console.log('Pedido aprovado:', pm.environment.get('pendingPedidoId'))"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": {
