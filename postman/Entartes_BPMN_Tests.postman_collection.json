{
  "info": {
    "name": "Ent'Artes API - testes BPMN",
    "description": "Coleção de testes para API Ent'Artes baseada nos fluxos BPMN E2E",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "authToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "userId",
      "value": "",
      "type": "string"
    },
    {
      "key": "role",
      "value": "",
      "type": "string"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{authToken}}"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "javascript",
        "exec": [
          "// Auto-add Authorization header if token exists",
          "if (pm.environment.get('authToken')) {",
          "  pm.request.headers.add({ key: 'Authorization', value: 'Bearer ' + pm.environment.get('authToken') });",
          "}",
          "pm.request.headers.add({ key: 'Content-Type', value: 'application/json' });"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "🟢 AUTH - Login (sem autenticacao)",
      "item": [
        {
          "name": "POST Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.expect(pm.response.status).to.eql(200));",
                  "pm.test('Success true', () => pm.expect(pm.response.json().success).to.be.true);",
                  "pm.test('Token exists', () => pm.expect(pm.response.json().token).to.not.be.empty);",
                  "",
                  "// Save token and user info",
                  "const json = pm.response.json();",
                  "if (json.token) {",
                  "    pm.environment.set('authToken', json.token);",
                  "    pm.environment.set('userId', json.user?.id?.toString());",
                  "    pm.environment.set('role', json.user?.role);",
                  "}",
                  "",
                  "console.log('Logged in as:', json.user?.role, '| ID:', json.user?.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "path": ["api", "auth", "login"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            }
          }
        },
        {
          "name": "POST Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 or 400', () => pm.expect([200, 400]).to.include(pm.response.status));",
                  "",
                  "const json = pm.response.json();",
                  "if (json.error && json.error.includes('já registado')) {",
                  "    console.log('User already exists - OK');",
                  "} else {",
                  "    pm.expect(json.user).to.have.property('id');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "path": ["api", "auth", "register"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Test User\",\n  \"email\": \"test{{$randomInt}}@test.com\",\n  \"telemovel\": \"912345678\",\n  \"password\": \"password123\"\n}"
            }
          }
        },
        {
          "name": "POST Forgot Password",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/auth/forgot-password",
              "path": ["api", "auth", "forgot-password"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 or 404', () => pm.expect([200, 404]).to.include(pm.response.status));",
                  "pm.test('Response has token or error', () => {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.success !== undefined).to.be.true;",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "📋 BPMN 1 - Pedido de Aula",
      "item": [
        {
          "name": "1. Login como ENCARREGADO",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Login OK', () => pm.expect(pm.response.json().success).to.be.true);",
                  "pm.environment.set('authToken', pm.response.json().token);",
                  "pm.environment.set('role', 'ENCARREGADO');",
                  "console.log('ENCARREGADO logged in')"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "path": ["api", "auth", "login"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"pedro.oliveira@email.pt\",\n  \"password\": \"password123\"\n}"
            }
          }
        },
        {
          "name": "2. Obter disponibilidades (publico)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.expect(pm.response.status).to.eql(200));",
                  "pm.test('Has data array', () => pm.expect(pm.response.json().data).to.be.an('array'));",
                  "",
                  "// Save first available slot for next request",
                  "const slots = pm.response.json().data || [];",
                  "const available = slots.find(s => s.maxDuracao > 0);",
                  "if (available) {",
                  "    pm.environment.set('slotId', available.id);",
                  "    pm.environment.set('slotData', available.data);",
                  "    pm.environment.set('slotHoraInicio', available.horaInicio);",
                  "    pm.environment.set('slotMaxDuracao', available.maxDuracao);",
                  "    console.log('Slot found:', available.id, available.data);",
                  "} else {",
                  "    console.log('No available slots');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/public/disponibilidades",
              "path": ["api", "public", "disponibilidades"]
            }
          }
        },
        {
          "name": "3. Criar pedido de aula (ENCARREGADO)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.expect([201, 200]).to.include(pm.response.status));",
                  "",
                  "const json = pm.response.json();",
                  "if (json.success) {",
                  "    pm.environment.set('pedidoId', json.data?.id?.toString() || json.data?.idpedidoaula?.toString());",
                  "    console.log('Pedido created:', pm.environment.get('pedidoId'));",
                  "} else {",
                  "    console.log('Error:', json.error);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/encarregado/aulas",
              "path": ["api", "encarregado", "aulas"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"data\": \"{{slotData}}\",\n  \"horainicio\": \"{{slotHoraInicio}}\",\n  \"duracaoaula\": 60,\n  \"disponibilidade_mensal_id\": {{slotId}},\n  \"salaidsala\": 1,\n  \"privacidade\": false\n}"
            }
          }
        },
        {
          "name": "4. Logout ENCARREGADO",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/auth/logout",
              "path": ["api", "auth", "logout"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.environment.set('authToken', '');",
                  "console.log('Logged out')"
                ]
              }
            }
          ]
        },
        {
          "name": "5. Login como DIRECAO",
          "event": [
            {
              "listen": "test",
              "script": {
